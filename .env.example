# ==============================================================================
# DevCore Agent Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and provide your credentials before running the agent.
# Usage: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider & API Keys
# ------------------------------------------------------------------------------
# Active provider: 'gemini' | 'openai' | 'anthropic' | 'ollama'
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required if LLM_PROVIDER=anthropic)
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Endpoint (Used if LLM_PROVIDER=ollama for local inference)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Model Parameters & Fine-tuning
# ------------------------------------------------------------------------------
# Model identifier to invoke
DEVCORE_MODEL_NAME=gemini-1.5-pro-latest

# Sampling temperature (0.0 to 1.0). Lower is strictly deterministic for code generation.
DEVCORE_TEMPERATURE=0.1

# Maximum output tokens per reasoning loop
DEVCORE_MAX_OUTPUT_TOKENS=8192

# Maximum autonomous reasoning & tool execution steps per task
DEVCORE_MAX_STEPS=25

# ------------------------------------------------------------------------------
# 3. Workspace & Execution Sandbox Settings
# ------------------------------------------------------------------------------
# Absolute or relative path to the target repository being analyzed
DEVCORE_WORKSPACE_ROOT=.

# Execution security mode:
# - 'strict': Requires interactive user consent for every write/execute operation
# - 'sandbox': Auto-approves safe non-destructive actions, gates dangerous operations
# - 'dry-run': Simulates all actions, writes no files, executes no commands
DEVCORE_EXEC_MODE=sandbox

# Process execution timeout in milliseconds for shell commands
DEVCORE_TIMEOUT_MS=60000

# Containerized Docker isolation for shell commands (true | false)
DEVCORE_ENABLE_DOCKER=false
DEVCORE_DOCKER_IMAGE=node:20-alpine

# ------------------------------------------------------------------------------
# 4. Context Engine & Vector Database
# ------------------------------------------------------------------------------
# Vector store provider: 'chroma' | 'qdrant' | 'memory'
DEVCORE_VECTOR_STORE=chroma

# ChromaDB local storage directory
DEVCORE_CHROMA_PATH=.devcore/vector_store

# Qdrant configuration (Optional, if DEVCORE_VECTOR_STORE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Embedding model identifier
DEVCORE_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 5. REST & WebSocket Daemon Configuration
# ------------------------------------------------------------------------------
# Host interface and port for daemon mode
DEVCORE_HOST=127.0.0.1
DEVCORE_PORT=8080

# Secret bearer token for authenticating HTTP/WS requests to the daemon
DEVCORE_SECRET=replace_with_a_secure_random_token_for_daemon_auth

# ------------------------------------------------------------------------------
# 6. Logging, Telemetry & Guardrails
# ------------------------------------------------------------------------------
# Logging level: 'debug' | 'info' | 'warn' | 'error'
DEVCORE_LOG_LEVEL=info

# Automatically scrub credentials and sensitive tokens from outgoing LLM payloads
DEVCORE_SCRUB_CREDENTIALS=true

# Anonymous crash and telemetry reporting (true | false)
DEVCORE_ANONYMIZE_TELEMETRY=false

